# Copy this file to backend/.env (or repo-root .env, per your deploy method) and fill in real values.
# See README.md "Deploying on your VPS (Docker)" for how this gets used.

# Shared password for the admin panel (/admin.html). Change this to something strong before
# going live - the app has no other authentication on top of it.
ADMIN_PASSWORD=change_this_to_a_strong_password

# Port the server listens on. Leave unset on hosts that assign it for you (e.g. cPanel/Passenger).
PORT=3000
